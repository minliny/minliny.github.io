# =============================================
# Notion 同步配置（必需）
# =============================================

# Notion Integration Token
# 获取方式：
# 1. 打开 https://www.notion.so/my-integrations
# 2. 新建一个 Internal Integration
# 3. 复制生成的 Token，格式如：secret_xxxxxxxxxxxx
NOTION_TOKEN=

# Notion 数据库 ID
# 获取方式：
# 1. 打开你的文章数据库页面
# 2. 从 URL 中复制数据库 ID（介于最后一个 / 和 ? 之间的 32 位字符串）
# 或在新版 Notion 中，直接从数据库页面的 URL 末尾获取
NOTION_DATABASE_ID=

# =============================================
# 站点配置（必需）
# =============================================

# canonical 站点根 URL，末尾不带斜杠
# 用于 canonical、Open Graph、RSS、sitemap、manifest 和 robots
SITE_URL=https://blog.minliny.com

# =============================================
# 可选同步行为配置
# =============================================

# 允许 Notion 数据库没有 Published 文章时继续同步（默认关闭）
ALLOW_EMPTY_NOTION_SYNC=

# Notion 全量快照目录；相对路径以 blog-frontend/ 为基准
CONTENT_DIR=.content/notion

# Excerpt 留空时使用 GitHub Models 生成智能摘要
# GitHub Actions 会自动使用 github.token；只有本地调用时才需要填 Token
AI_SUMMARY_TOKEN=
AI_SUMMARY_MODEL=openai/gpt-4.1-mini

# 生成后写回 Notion Excerpt 作为缓存，避免定时构建重复调用模型
AI_SUMMARY_WRITEBACK=1

# 高级校验：设为 1 时，正文出现尚未支持的 Notion Block 才会阻止发布
# 默认留空，不因个别未支持 Block 阻塞整站更新
STRICT_UNSUPPORTED_BLOCKS=

# 仅在你自行扩展 GitHub API 调用时使用
GITHUB_TOKEN=
