{
  "name": "blog-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Static blog frontend with Notion publishing sync",
  "scripts": {
    "doctor:notion": "node scripts/notion-doctor.js",
    "sync:notion": "node scripts/sync-notion.js",
    "sync:notion:dry": "node scripts/sync-notion.js --dry-run",
    "build": "npm run build:fixtures",
    "build:fixtures": "node scripts/build-site.js --content content/fixtures",
    "build:notion": "node scripts/build-site.js --content .content/notion",
    "validate": "node scripts/validate-dist.js",
    "test": "node --test",
    "check": "npm test && npm run build:fixtures && npm run validate",
    "serve": "python3 -m http.server 4321 --directory dist",
    "fingerprint": "node scripts/publish-fingerprint.js",
    "package:pages": "node scripts/package-pages-release.js",
    "verify:pages": "node scripts/verify-pages-release.js",
    "smoke:pages": "node scripts/smoke-deployment.js"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "highlight.js": "11.9.0",
    "marked": "9.1.6",
    "sanitize-html": "2.17.0"
  }
}
